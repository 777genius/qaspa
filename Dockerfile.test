FROM rust:1.85-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    protobuf-compiler \
    libprotobuf-dev \
    pkg-config \
    libssl-dev \
    build-essential \
    clang \
    libclang-dev \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

RUN protoc --version

WORKDIR /app
COPY . .

# Run the comprehensive ML-DSA E2E suite in the build step.
# The CI workflow uses cache-only outputs to avoid loading large images.
RUN echo "Building kaspad..." && \
    cargo build --locked --release -p kaspad && \
    ls -lh target/release/kaspad

RUN echo "Running txscript E2E comprehensive tests..." && \
    cargo test --locked -p kaspa-txscript --release --test e2e_comprehensive -- --ignored --nocapture --test-threads=1

RUN echo "Running ML-DSA transaction E2E tests..." && \
    cargo test --locked -p kaspa-txscript --release --test mldsa_transactions_e2e -- --ignored --nocapture --test-threads=1
