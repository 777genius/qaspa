// **************************************************************************
// StoreGenerator
// **************************************************************************

// ignore_for_file: non_constant_identifier_names, unnecessary_brace_in_string_interps, unnecessary_lambdas, prefer_expression_function_bodies, lines_longer_than_80_chars, avoid_as, avoid_annotating_with_dynamic, no_leading_underscores_for_local_identifiers

mixin _$ReceiveStore on _ReceiveStoreBase, Store {
  late final _$currentAddressAtom = Atom(
    name: '_ReceiveStoreBase.currentAddress',
    context: context,
  );

  @override
  Address? get currentAddress {
    _$currentAddressAtom.reportRead();
    return super.currentAddress;
  }

  @override
  set currentAddress(Address? value) {
    _$currentAddressAtom.reportWrite(value, super.currentAddress, () {
      super.currentAddress = value;
    });
  }

  late final _$isLoadingAtom = Atom(
    name: '_ReceiveStoreBase.isLoading',
    context: context,
  );

  @override
  bool get isLoading {
    _$isLoadingAtom.reportRead();
    return super.isLoading;
  }

  @override
  set isLoading(bool value) {
    _$isLoadingAtom.reportWrite(value, super.isLoading, () {
      super.isLoading = value;
    });
  }

  late final _$errorMessageAtom = Atom(
    name: '_ReceiveStoreBase.errorMessage',
    context: context,
  );

  @override
  String? get errorMessage {
    _$errorMessageAtom.reportRead();
    return super.errorMessage;
  }

  @override
  set errorMessage(String? value) {
    _$errorMessageAtom.reportWrite(value, super.errorMessage, () {
      super.errorMessage = value;
    });
  }

  late final _$currentAccountIdAtom = Atom(
    name: '_ReceiveStoreBase.currentAccountId',
    context: context,
  );

  @override
  String? get currentAccountId {
    _$currentAccountIdAtom.reportRead();
    return super.currentAccountId;
  }

  @override
  set currentAccountId(String? value) {
    _$currentAccountIdAtom.reportWrite(value, super.currentAccountId, () {
      super.currentAccountId = value;
    });
  }

  late final _$addressCopiedAtom = Atom(
    name: '_ReceiveStoreBase.addressCopied',
    context: context,
  );

  @override
  bool get addressCopied {
    _$addressCopiedAtom.reportRead();
    return super.addressCopied;
  }

  @override
  set addressCopied(bool value) {
    _$addressCopiedAtom.reportWrite(value, super.addressCopied, () {
      super.addressCopied = value;
    });
  }

  late final _$loadAddressAsyncAction = AsyncAction(
    '_ReceiveStoreBase.loadAddress',
    context: context,
  );

  @override
  Future<void> loadAddress() {
    return _$loadAddressAsyncAction.run(() => super.loadAddress());
  }

  late final _$generateNewAddressAsyncAction = AsyncAction(
    '_ReceiveStoreBase.generateNewAddress',
    context: context,
  );

  @override
  Future<void> generateNewAddress() {
    return _$generateNewAddressAsyncAction.run(
      () => super.generateNewAddress(),
    );
  }

  late final _$_ReceiveStoreBaseActionController = ActionController(
    name: '_ReceiveStoreBase',
    context: context,
  );

  @override
  void setAccountId(String accountId) {
    final _$actionInfo = _$_ReceiveStoreBaseActionController.startAction(
      name: '_ReceiveStoreBase.setAccountId',
    );
    try {
      return super.setAccountId(accountId);
    } finally {
      _$_ReceiveStoreBaseActionController.endAction(_$actionInfo);
    }
  }

  @override
  void setAddressCopied(bool value) {
    final _$actionInfo = _$_ReceiveStoreBaseActionController.startAction(
      name: '_ReceiveStoreBase.setAddressCopied',
    );
    try {
      return super.setAddressCopied(value);
    } finally {
      _$_ReceiveStoreBaseActionController.endAction(_$actionInfo);
    }
  }

  @override
  void reset() {
    final _$actionInfo = _$_ReceiveStoreBaseActionController.startAction(
      name: '_ReceiveStoreBase.reset',
    );
    try {
      return super.reset();
    } finally {
      _$_ReceiveStoreBaseActionController.endAction(_$actionInfo);
    }
  }

  @override
  String toString() {
    return '''
currentAddress: ${currentAddress},
isLoading: ${isLoading},
errorMessage: ${errorMessage},
currentAccountId: ${currentAccountId},
addressCopied: ${addressCopied}
    ''';
  }
}
