// ignore_for_file: non_constant_identifier_names, unnecessary_brace_in_string_interps, unnecessary_lambdas, prefer_expression_function_bodies, lines_longer_than_80_chars, avoid_as, avoid_annotating_with_dynamic, no_leading_underscores_for_local_identifiers

mixin _$OnboardingStore on _OnboardingStoreBase, Store {
  Computed<bool>? _$canProceedFromGenerateComputed;

  @override
  bool get canProceedFromGenerate =>
      (_$canProceedFromGenerateComputed ??= Computed<bool>(
        () => super.canProceedFromGenerate,
        name: '_OnboardingStoreBase.canProceedFromGenerate',
      )).value;
  Computed<bool>? _$canProceedFromBackupComputed;

  @override
