flow: ${flow},
currentStep: ${currentStep},
mnemonic: ${mnemonic},
isMnemonicRevealed: ${isMnemonicRevealed},
isBackupConfirmed: ${isBackupConfirmed},
importedWords: ${importedWords},
verification: ${verification},
password: ${password},
confirmPassword: ${confirmPassword},
selectedNetwork: ${selectedNetwork},
isLoading: ${isLoading},
errorMessage: ${errorMessage},
createdWallet: ${createdWallet},
walletName: ${walletName},
canProceedFromGenerate: ${canProceedFromGenerate},
