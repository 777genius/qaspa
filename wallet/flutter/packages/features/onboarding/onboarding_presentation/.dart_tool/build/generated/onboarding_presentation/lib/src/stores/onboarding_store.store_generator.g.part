  late final _$_OnboardingStoreBaseActionController = ActionController(
    name: '_OnboardingStoreBase',
    context: context,
  );

  @override
  void selectFlow(OnboardingFlow selectedFlow) {
    final _$actionInfo = _$_OnboardingStoreBaseActionController.startAction(
