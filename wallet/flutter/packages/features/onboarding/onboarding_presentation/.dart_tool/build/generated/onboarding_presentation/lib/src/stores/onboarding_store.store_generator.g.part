    name: '_OnboardingStoreBase.currentStepNumber',
  )).value;

  late final _$flowAtom = Atom(
    name: '_OnboardingStoreBase.flow',
    context: context,
  );

  @override
  OnboardingFlow? get flow {
    _$flowAtom.reportRead();
    return super.flow;
  }

  @override
  set flow(OnboardingFlow? value) {
    _$flowAtom.reportWrite(value, super.flow, () {
      super.flow = value;
    });
  }

