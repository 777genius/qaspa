    _$stealthAddressAtom.reportRead();
    return super.stealthAddress;
  }

  @override
  set stealthAddress(Address? value) {
    _$stealthAddressAtom.reportWrite(value, super.stealthAddress, () {
      super.stealthAddress = value;
    });
  }

