        name: '_StealthStoreBase.stealthBalanceInKas',
      )).value;
  Computed<bool>? _$canSendComputed;

  @override
  bool get canSend => (_$canSendComputed ??= Computed<bool>(
    () => super.canSend,
    name: '_StealthStoreBase.canSend',
  )).value;
