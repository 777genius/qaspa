  @override
  BigInt get sendAmountInSompi =>
      (_$sendAmountInSompiComputed ??= Computed<BigInt>(
        () => super.sendAmountInSompi,
        name: '_StealthStoreBase.sendAmountInSompi',
      )).value;

  late final _$stealthAddressAtom = Atom(
