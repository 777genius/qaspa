class TransactionRecord extends DataClass
    implements Insertable<TransactionRecord> {
  final String id;
  final String accountId;
  final String kind;
  final String networkId;
  final int timestamp;

  /// Amount in SOMPI stored as TEXT for BigInt support
  final String amount;

  /// Fee in SOMPI stored as TEXT for BigInt support (nullable)
  final String? fee;

  /// JSON-encoded list of addresses
  final String? fromAddresses;

  /// JSON-encoded list of addresses
  final String? toAddresses;
  final String? note;
  final String? metadata;
  final int? acceptedDaaScore;
  final bool isConfirmed;
  const TransactionRecord(
      {required this.id,
      required this.accountId,
      required this.kind,
      required this.networkId,
      required this.timestamp,
      required this.amount,
      this.fee,
      this.fromAddresses,
      this.toAddresses,
      this.note,
      this.metadata,
      this.acceptedDaaScore,
      required this.isConfirmed});
  @override
  Map<String, Expression> toColumns(bool nullToAbsent) {
    final map = <String, Expression>{};
    map['id'] = Variable<String>(id);
    map['account_id'] = Variable<String>(accountId);
    map['kind'] = Variable<String>(kind);
    map['network_id'] = Variable<String>(networkId);
    map['timestamp'] = Variable<int>(timestamp);
    map['amount'] = Variable<String>(amount);
    if (!nullToAbsent || fee != null) {
      map['fee'] = Variable<String>(fee);
    }
    if (!nullToAbsent || fromAddresses != null) {
      map['from_addresses'] = Variable<String>(fromAddresses);
    }
    if (!nullToAbsent || toAddresses != null) {
      map['to_addresses'] = Variable<String>(toAddresses);
    }
    if (!nullToAbsent || note != null) {
      map['note'] = Variable<String>(note);
    }
    if (!nullToAbsent || metadata != null) {
      map['metadata'] = Variable<String>(metadata);
    }
    if (!nullToAbsent || acceptedDaaScore != null) {
      map['accepted_daa_score'] = Variable<int>(acceptedDaaScore);
    }
    map['is_confirmed'] = Variable<bool>(isConfirmed);
    return map;
  }

  TransactionRecordsCompanion toCompanion(bool nullToAbsent) {
    return TransactionRecordsCompanion(
      id: Value(id),
      accountId: Value(accountId),
      kind: Value(kind),
      networkId: Value(networkId),
      timestamp: Value(timestamp),
      amount: Value(amount),
      fee: fee == null && nullToAbsent ? const Value.absent() : Value(fee),
      fromAddresses: fromAddresses == null && nullToAbsent
          ? const Value.absent()
          : Value(fromAddresses),
      toAddresses: toAddresses == null && nullToAbsent
          ? const Value.absent()
          : Value(toAddresses),
      note: note == null && nullToAbsent ? const Value.absent() : Value(note),
      metadata: metadata == null && nullToAbsent
          ? const Value.absent()
          : Value(metadata),
      acceptedDaaScore: acceptedDaaScore == null && nullToAbsent
          ? const Value.absent()
          : Value(acceptedDaaScore),
      isConfirmed: Value(isConfirmed),
    );
  }

  factory TransactionRecord.fromJson(Map<String, dynamic> json,
      {ValueSerializer? serializer}) {
    serializer ??= driftRuntimeOptions.defaultSerializer;
    return TransactionRecord(
      id: serializer.fromJson<String>(json['id']),
      accountId: serializer.fromJson<String>(json['accountId']),
      kind: serializer.fromJson<String>(json['kind']),
      networkId: serializer.fromJson<String>(json['networkId']),
      timestamp: serializer.fromJson<int>(json['timestamp']),
      amount: serializer.fromJson<String>(json['amount']),
      fee: serializer.fromJson<String?>(json['fee']),
      fromAddresses: serializer.fromJson<String?>(json['fromAddresses']),
      toAddresses: serializer.fromJson<String?>(json['toAddresses']),
      note: serializer.fromJson<String?>(json['note']),
      metadata: serializer.fromJson<String?>(json['metadata']),
      acceptedDaaScore: serializer.fromJson<int?>(json['acceptedDaaScore']),
      isConfirmed: serializer.fromJson<bool>(json['isConfirmed']),
    );
  }
  @override
  Map<String, dynamic> toJson({ValueSerializer? serializer}) {
    serializer ??= driftRuntimeOptions.defaultSerializer;
    return <String, dynamic>{
      'id': serializer.toJson<String>(id),
      'accountId': serializer.toJson<String>(accountId),
      'kind': serializer.toJson<String>(kind),
      'networkId': serializer.toJson<String>(networkId),
      'timestamp': serializer.toJson<int>(timestamp),
      'amount': serializer.toJson<String>(amount),
      'fee': serializer.toJson<String?>(fee),
      'fromAddresses': serializer.toJson<String?>(fromAddresses),
      'toAddresses': serializer.toJson<String?>(toAddresses),
      'note': serializer.toJson<String?>(note),
      'metadata': serializer.toJson<String?>(metadata),
      'acceptedDaaScore': serializer.toJson<int?>(acceptedDaaScore),
      'isConfirmed': serializer.toJson<bool>(isConfirmed),
    };
  }

  TransactionRecord copyWith(
          {String? id,
          String? accountId,
          String? kind,
          String? networkId,
          int? timestamp,
          String? amount,
          Value<String?> fee = const Value.absent(),
          Value<String?> fromAddresses = const Value.absent(),
          Value<String?> toAddresses = const Value.absent(),
          Value<String?> note = const Value.absent(),
          Value<String?> metadata = const Value.absent(),
          Value<int?> acceptedDaaScore = const Value.absent(),
          bool? isConfirmed}) =>
      TransactionRecord(
        id: id ?? this.id,
        accountId: accountId ?? this.accountId,
        kind: kind ?? this.kind,
        networkId: networkId ?? this.networkId,
        timestamp: timestamp ?? this.timestamp,
        amount: amount ?? this.amount,
        fee: fee.present ? fee.value : this.fee,
        fromAddresses:
            fromAddresses.present ? fromAddresses.value : this.fromAddresses,
        toAddresses: toAddresses.present ? toAddresses.value : this.toAddresses,
        note: note.present ? note.value : this.note,
        metadata: metadata.present ? metadata.value : this.metadata,
        acceptedDaaScore: acceptedDaaScore.present
            ? acceptedDaaScore.value
            : this.acceptedDaaScore,
        isConfirmed: isConfirmed ?? this.isConfirmed,
      );
  TransactionRecord copyWithCompanion(TransactionRecordsCompanion data) {
    return TransactionRecord(
      id: data.id.present ? data.id.value : this.id,
      accountId: data.accountId.present ? data.accountId.value : this.accountId,
      kind: data.kind.present ? data.kind.value : this.kind,
      networkId: data.networkId.present ? data.networkId.value : this.networkId,
      timestamp: data.timestamp.present ? data.timestamp.value : this.timestamp,
      amount: data.amount.present ? data.amount.value : this.amount,
      fee: data.fee.present ? data.fee.value : this.fee,
      fromAddresses: data.fromAddresses.present
          ? data.fromAddresses.value
          : this.fromAddresses,
      toAddresses:
          data.toAddresses.present ? data.toAddresses.value : this.toAddresses,
      note: data.note.present ? data.note.value : this.note,
      metadata: data.metadata.present ? data.metadata.value : this.metadata,
      acceptedDaaScore: data.acceptedDaaScore.present
          ? data.acceptedDaaScore.value
          : this.acceptedDaaScore,
      isConfirmed:
          data.isConfirmed.present ? data.isConfirmed.value : this.isConfirmed,
    );
  }

  @override
  String toString() {
    return (StringBuffer('TransactionRecord(')
          ..write('id: $id, ')
          ..write('accountId: $accountId, ')
          ..write('kind: $kind, ')
          ..write('networkId: $networkId, ')
          ..write('timestamp: $timestamp, ')
          ..write('amount: $amount, ')
          ..write('fee: $fee, ')
          ..write('fromAddresses: $fromAddresses, ')
          ..write('toAddresses: $toAddresses, ')
          ..write('note: $note, ')
          ..write('metadata: $metadata, ')
          ..write('acceptedDaaScore: $acceptedDaaScore, ')
          ..write('isConfirmed: $isConfirmed')
          ..write(')'))
        .toString();
  }

  @override
  int get hashCode => Object.hash(
      id,
      accountId,
      kind,
      networkId,
      timestamp,
      amount,
      fee,
      fromAddresses,
      toAddresses,
      note,
      metadata,
      acceptedDaaScore,
      isConfirmed);
  @override
  bool operator ==(Object other) =>
      identical(this, other) ||
      (other is TransactionRecord &&
          other.id == this.id &&
          other.accountId == this.accountId &&
          other.kind == this.kind &&
          other.networkId == this.networkId &&
          other.timestamp == this.timestamp &&
          other.amount == this.amount &&
          other.fee == this.fee &&
          other.fromAddresses == this.fromAddresses &&
          other.toAddresses == this.toAddresses &&
          other.note == this.note &&
          other.metadata == this.metadata &&
          other.acceptedDaaScore == this.acceptedDaaScore &&
          other.isConfirmed == this.isConfirmed);
}

