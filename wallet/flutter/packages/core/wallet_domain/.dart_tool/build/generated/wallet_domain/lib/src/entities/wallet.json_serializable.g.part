// **************************************************************************
// JsonSerializableGenerator
// **************************************************************************

_Wallet _$WalletFromJson(Map<String, dynamic> json) => _Wallet(
      id: json['id'] as String,
      name: json['name'] as String,
      networkId: json['networkId'] as String,
      isOpen: json['isOpen'] as bool? ?? false,
      createdAt: (json['createdAt'] as num).toInt(),
      lastAccessedAt: (json['lastAccessedAt'] as num?)?.toInt(),
      accountIds: (json['accountIds'] as List<dynamic>?)
              ?.map((e) => e as String)
              .toList() ??
          const [],
    );

Map<String, dynamic> _$WalletToJson(_Wallet instance) => <String, dynamic>{
      'id': instance.id,
      'name': instance.name,
      'networkId': instance.networkId,
      'isOpen': instance.isOpen,
      'createdAt': instance.createdAt,
      'lastAccessedAt': instance.lastAccessedAt,
      'accountIds': instance.accountIds,
    };

_WalletDescriptor _$WalletDescriptorFromJson(Map<String, dynamic> json) =>
    _WalletDescriptor(
      id: json['id'] as String,
      name: json['name'] as String,
      networkId: json['networkId'] as String,
      createdAt: (json['createdAt'] as num).toInt(),
    );

Map<String, dynamic> _$WalletDescriptorToJson(_WalletDescriptor instance) =>
    <String, dynamic>{
      'id': instance.id,
      'name': instance.name,
      'networkId': instance.networkId,
      'createdAt': instance.createdAt,
    };
