// **************************************************************************
// JsonSerializableGenerator
// **************************************************************************

_Balance _$BalanceFromJson(Map<String, dynamic> json) => _Balance(
      mature: const BigIntConverter().fromJson(json['mature'] as String),
      pending: const BigIntConverter().fromJson(json['pending'] as String),
      outgoing: const BigIntConverter().fromJson(json['outgoing'] as String),
      matureUtxoCount: (json['matureUtxoCount'] as num).toInt(),
      pendingUtxoCount: (json['pendingUtxoCount'] as num).toInt(),
      stasisUtxoCount: (json['stasisUtxoCount'] as num).toInt(),
    );

Map<String, dynamic> _$BalanceToJson(_Balance instance) => <String, dynamic>{
      'mature': const BigIntConverter().toJson(instance.mature),
      'pending': const BigIntConverter().toJson(instance.pending),
      'outgoing': const BigIntConverter().toJson(instance.outgoing),
      'matureUtxoCount': instance.matureUtxoCount,
      'pendingUtxoCount': instance.pendingUtxoCount,
      'stasisUtxoCount': instance.stasisUtxoCount,
    };
